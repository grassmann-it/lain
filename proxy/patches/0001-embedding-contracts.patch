+package helps
+
+import (
+	"context"
+	"github.com/router-for-me/CLIProxyAPI/v8/sdk/cliproxy/usage"
+	"testing"
+)
+
+func TestReportedUsageDoesNotInventTotalsOrEraseZero(t *testing.T) {
+	openai := ParseOpenAIUsage([]byte(`{"usage":{"prompt_tokens":0,"completion_tokens":7}}`))
+	if openai.Reported == nil || openai.Reported.InputTokens == nil || *openai.Reported.InputTokens != 0 || openai.Reported.TotalTokens != nil || openai.Reported.ReasoningTokens != nil {
+		t.Fatalf("presence lost: %#v", openai.Reported)
+	}
+	first := ParseClaudeUsage([]byte(`{"usage":{"input_tokens":9,"output_tokens":3}}`))
+	update := ParseClaudeUsage([]byte(`{"usage":{"output_tokens":0,"cache_read_input_tokens":0}}`))
+	merged := MergeStreamUsageDetail(first, update)
+	if *merged.Reported.InputTokens != 9 || *merged.Reported.OutputTokens != 0 || *merged.Reported.CacheReadTokens != 0 || merged.Reported.TotalTokens != nil {
+		t.Fatal("Claude start/delta presence lost")
+	}
+	var buffer StreamUsageBuffer
+	buffer.ObserveOpenAIStream([]byte(`data: {"service_tier":"default","usage":{"prompt_tokens":0,"completion_tokens":0,"total_tokens":0}}`))
+	detail, ok := buffer.Detail()
+	if !ok || detail.Reported == nil || detail.Reported.TotalTokens == nil || *detail.Reported.TotalTokens != 0 {
+		t.Fatal("zero usage plus service tier lost presence")
+	}
+	reporter := NewUsageReporter(usage.WithExecutionRequestID(context.Background(), "bound-attempt"), "fixture", "model", nil)
+	if reporter.RequestID() != "bound-attempt" {
+		t.Fatal("bound attempt ID overwritten")
+	}
+}
