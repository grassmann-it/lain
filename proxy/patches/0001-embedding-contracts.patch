+package usage
+
+import "context"
+
+// ReportedDetail preserves absent versus explicitly reported zero components.
+// Values retain the provider wire semantics; computed totals are never inserted.
+type ReportedDetail struct {
+	InputTokens, OutputTokens, TotalTokens                *int64
+	CacheReadTokens, CacheCreationTokens, ReasoningTokens *int64
+}
+
+// DurableSink must latch its failure so the executor owner can fail closed.
+// It runs synchronously before records are visible to the volatile usage queue.
+type DurableSink func(context.Context, Record) error
+type durableSinkContextKey struct{}
+
+func WithDurableSink(ctx context.Context, sink DurableSink) context.Context {
+	if ctx == nil {
+		ctx = context.Background()
+	}
+	return context.WithValue(ctx, durableSinkContextKey{}, sink)
+}
