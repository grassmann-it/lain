+package helps
+
+import (
+	"github.com/router-for-me/CLIProxyAPI/v8/sdk/cliproxy/usage"
+	"github.com/tidwall/gjson"
+)
+
+func reportedToken(node gjson.Result) *int64 {
+	if !node.Exists() || node.Type != gjson.Number {
+		return nil
+	}
+	value := node.Int()
+	if value < 0 || node.Float() != float64(value) {
+		return nil
+	}
+	return &value
+}
+
+func mergeReportedUsage(previous, update *usage.ReportedDetail) *usage.ReportedDetail {
+	if previous == nil {
+		return update
+	}
+	if update == nil {
+		return previous
+	}
+	merged := *update
+	if merged.InputTokens == nil {
+		merged.InputTokens = previous.InputTokens
+	}
+	if merged.OutputTokens == nil {
+		merged.OutputTokens = previous.OutputTokens
+	}
+	if merged.TotalTokens == nil {
+		merged.TotalTokens = previous.TotalTokens
+	}
+	if merged.CacheReadTokens == nil {
+		merged.CacheReadTokens = previous.CacheReadTokens
+	}
+	if merged.CacheCreationTokens == nil {
+		merged.CacheCreationTokens = previous.CacheCreationTokens
+	}
+	if merged.ReasoningTokens == nil {
+		merged.ReasoningTokens = previous.ReasoningTokens
+	}
+	return &merged
+}
