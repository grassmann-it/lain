+package auth
+
+import "errors"
+
+// SetExecutorDecorator installs a wrapper before the first executor registration.
+// Every subsequent registration is decorated before it becomes visible to refresh
+// or inference. The decorator runs under the manager lock and must not re-enter it.
+func (m *Manager) SetExecutorDecorator(decorate func(ProviderExecutor) ProviderExecutor) error {
+	m.mu.Lock()
+	defer m.mu.Unlock()
+	if len(m.executors) != 0 {
+		return errors.New("executor decorator must be installed before registration")
+	}
+	m.executorDecorator = decorate
+	return nil
+}
