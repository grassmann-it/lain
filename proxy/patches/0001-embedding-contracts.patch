+package usage
+
+import (
+	"context"
+	"errors"
+	"testing"
+)
+
+func TestDurableSinkPrecedesQueueAndFailureCannotEnqueue(t *testing.T) {
+	manager := NewManager(1)
+	calls := 0
+	ctx := WithDurableSink(context.Background(), func(context.Context, Record) error {
+		calls++
+		if len(manager.queue) != 0 {
+			t.Fatal("queue visible before durability")
+		}
+		return errors.New("disk full")
+	})
+	manager.Publish(ctx, Record{RequestID: "attempt"})
+	if calls != 1 || len(manager.queue) != 0 {
+		t.Fatal("failed durable write reached queue")
+	}
+}
