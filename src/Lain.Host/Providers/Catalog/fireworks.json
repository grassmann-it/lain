{
  "id": "fireworks",
  "name": "Fireworks",
  "summary": "Serverless inference with your own API key. Account quotas are separate from prepaid credit balance; starter credit and model access need account verification.",
  "accountUrl": "https://app.fireworks.ai/settings/users/api-keys",
  "documentationUrl": "https://docs.fireworks.ai/getting-started/quickstart",
  "credentials": [
    {
      "id": "apiKey",
      "label": "Fireworks API key",
      "kind": "api-key",
      "required": true,
      "secret": true,
      "help": "Create your own Fireworks API key. This serverless route does not use Fire Pass keys."
    },
    {
      "id": "accountId",
      "label": "Fireworks account ID (quota monitor)",
      "kind": "text",
      "required": false,
      "secret": false,
      "help": "For quota monitoring, copy the account ID from the Fireworks account settings; do not enter a user ID, display name, or model owner account."
    }
  ],
  "setupSteps": [
    {
      "title": "Create an API key",
      "description": "Create a key in your own account and enter it privately in lain.",
      "url": "https://app.fireworks.ai/settings/users/api-keys"
    },
    {
      "title": "Check the available credit",
      "description": "Check starter-credit eligibility, expiry, and billing before inference. No dedicated deployment or purchase is required by this connector.",
      "url": "https://fireworks.ai/billing"
    },
    {
      "title": "Optional quota monitor",
      "description": "Enter the Fireworks account ID. The key must be allowed to list that account’s quotas; if necessary, configure a separate authorized API key for the monitor.",
      "url": "https://docs.fireworks.ai/api-reference/list-quotas"
    }
  ],
  "billingPlans": [
    {
      "id": "starter",
      "name": "Starter credit (if granted)",
      "kind": "trial",
      "scope": "account",
      "unit": "USD",
      "notes": "The FAQ describes $1 starter credit. Actual allocation, balance and expiry are unverified; this is not a recurring free tier."
    },
    {
      "id": "payg",
      "name": "Serverless pay as you go",
      "kind": "payg",
      "scope": "account",
      "unit": "USD",
      "notes": "Uses account credits or the existing billing arrangement. No purchase, Auto Reload or paid fallback is enabled by lain."
    }
  ],
  "routes": [
    {
      "id": "fireworks:glm-5p2-fast:router:chat",
      "model": "accounts/fireworks/routers/glm-5p2-fast",
      "name": "glm-5p2-fast · router",
      "baseUrl": "https://api.fireworks.ai/inference/v1",
      "protocol": "openai-chat",
      "billingPlanIds": [
        "starter",
        "payg"
      ],
      "capabilities": {
        "streaming": true,
        "structuredOutput": true,
        "contextWindow": 1048576,
        "tools": true
      },
      "inferenceProvider": "Fireworks",
      "pricingClass": "paid",
      "freeOnlyEligible": false,
      "freeOnlyEnforcementKind": "unsupported",
      "sources": [
        {
          "url": "https://docs.fireworks.ai/getting-started/quickstart",
          "title": "Serverless quickstart and API key setup",
          "checkedAt": "2026-10-24T00:00:00Z"
        },
