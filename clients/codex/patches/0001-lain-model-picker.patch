+#[tokio::test]
+async fn lain_router_selection_preserves_wire_slug_and_existing_persistence() {
+    let (mut chat, mut rx, _ops) = make_chatwidget_manual(Some("member-a")).await;
+    configure_lain_picker(&mut chat, true);
+    chat.open_model_popup_with_presets(chat.model_catalog.models.clone());
+    chat.handle_key_event(KeyCode::Enter.into());
+    let group_id = assert_matches!(rx.try_recv(), Ok(AppEvent::OpenLainModelGroupPopup { group_id }) => group_id);
+    chat.open_lain_model_group_popup(&group_id);
+    let members = render_bottom_popup(&chat, 80);
+    assert!(members.find("Automatisch").unwrap() < members.find("Member A").unwrap());
+    chat.handle_key_event(KeyCode::Home.into());
+    chat.handle_key_event(KeyCode::Enter.into());
+    let preset = assert_matches!(rx.try_recv(), Ok(AppEvent::OpenReasoningPopup { model }) => model);
+    assert_eq!(preset.model, "router-free");
+    chat.open_reasoning_popup(preset);
+    assert_matches!(rx.try_recv(), Ok(AppEvent::UpdateModel(model)) if model == "router-free");
+    assert_matches!(rx.try_recv(), Ok(AppEvent::UpdateReasoningEffort(Some(ReasoningEffortConfig::None))));
+    assert_matches!(rx.try_recv(), Ok(AppEvent::PersistModelSelection { model, .. }) if model == "router-free");
+    assert!(chat.no_modal_or_popup_active());
+}
