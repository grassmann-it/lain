+//! Explicit, local catalog extension for lain's two-stage TUI model picker.
+//! This metadata changes presentation only; every selectable slug must already exist in the catalog.
+
+use codex_protocol::openai_models::ModelsResponse;
+use serde::Deserialize;
+use std::collections::HashSet;
+use std::io;
+
+#[derive(Debug, Clone, Deserialize, PartialEq, Eq)]
+#[serde(deny_unknown_fields)]
+pub struct LainModelPicker {
+    pub schema_version: u32,
+    pub groups: Vec<LainModelGroup>,
+}
+
+#[derive(Debug, Clone, Deserialize, PartialEq, Eq)]
+#[serde(deny_unknown_fields)]
+pub struct LainModelGroup {
+    pub id: String,
+    pub name: String,
+    #[serde(default)]
+    pub router_model: Option<String>,
+    pub models: Vec<String>,
+}
+
+#[derive(Deserialize)]
+pub(super) struct CatalogEnvelope {
+    #[serde(flatten)]
+    pub catalog: ModelsResponse,
+    #[serde(default)]
+    pub lain_model_picker: Option<LainModelPicker>,
+}
+
+impl LainModelPicker {
+    pub(super) fn validate(&self, catalog: &ModelsResponse) -> io::Result<()> {
+        self.validate_slugs(catalog.models.iter().map(|model| model.slug.as_str()))
+    }
+
+    fn validate_slugs<'a>(&self, slugs: impl Iterator<Item = &'a str>) -> io::Result<()> {
+        let invalid = |message: &str| io::Error::new(io::ErrorKind::InvalidData,
+            format!("invalid lain_model_picker: {message}"));
+        if self.schema_version != 1 {
+            return Err(invalid("unsupported schema_version (expected 1)"));
+        }
+        if self.groups.len() > 128 {
+            return Err(invalid("too many groups (maximum 128)"));
+        }
+        let slugs: HashSet<&str> = slugs.collect();
+        let mut ids = HashSet::new();
+        for group in &self.groups {
+            for label in [&group.id, &group.name] {
+                if label.trim().is_empty() || label.len() > 256 || label.chars().any(char::is_control) {
+                    return Err(invalid("group ids and names must be nonempty, single-line labels"));
+                }
+            }
+            if !ids.insert(group.id.as_str()) {
+                return Err(invalid("duplicate group id"));
+            }
+            if group.router_model.as_ref().is_some_and(|model| !slugs.contains(model.as_str())) {
+                return Err(invalid("router_model must reference an existing catalog slug"));
+            }
+            let mut members = HashSet::new();
+            for model in &group.models {
+                if !slugs.contains(model.as_str()) {
+                    return Err(invalid("group member must reference an existing catalog slug"));
+                }
+                if !members.insert(model.as_str()) {
+                    return Err(invalid("duplicate model in group"));
+                }
+            }
+        }
+        Ok(())
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn picker() -> LainModelPicker {
+        serde_json::from_str(r#"{"schema_version":1,"groups":[{"id":"free","name":"Free","router_model":null,"models":["model-a"]}]}"#).unwrap()
+    }
+
+    #[test]
+    fn metadata_allows_absent_router_and_overlapping_collections() {
+        let mut picker = picker();
+        let mut other = picker.groups[0].clone();
+        other.id = "security".to_string();
+        picker.groups.push(other);
+        assert!(picker.validate_slugs(["model-a"].into_iter()).is_ok());
+        picker.groups[0].router_model = Some("router-a".to_string());
+        assert!(picker.validate_slugs(["model-a", "router-a"].into_iter()).is_ok());
+    }
+
+    #[test]
+    fn metadata_rejects_unknown_router_member_version_and_duplicate_ids() {
+        let mut p = picker();
+        p.groups[0].router_model = Some("invented-router".to_string());
+        assert!(p.validate_slugs(["model-a"].into_iter()).is_err());
+        assert!(picker().validate_slugs(["other-model"].into_iter()).is_err());
+        p = picker(); p.schema_version = 2;
+        assert!(p.validate_slugs(["model-a"].into_iter()).is_err());
+        p = picker(); p.groups.push(p.groups[0].clone());
+        assert!(p.validate_slugs(["model-a"].into_iter()).is_err());
+    }
+
+    #[test]
+    fn catalog_without_extension_retains_upstream_models() {
+        let input = include_str!("../../../models-manager/models.json");
+        let upstream: ModelsResponse = serde_json::from_str(input).unwrap();
+        let envelope: CatalogEnvelope = serde_json::from_str(input).unwrap();
+        assert_eq!(envelope.catalog, upstream);
+        assert!(envelope.lain_model_picker.is_none());
+    }
+}
