+
+fn configure_lain_picker(chat: &mut ChatWidget, router: bool) {
+    use codex_core::config::lain_model_picker::LainModelGroup;
+    use codex_core::config::lain_model_picker::LainModelPicker;
+    let mut template = get_available_model(chat, "gpt-5.5");
+    template.default_reasoning_effort = ReasoningEffortConfig::None;
+    template.supported_reasoning_efforts.clear();
+    let presets = [("member-a", "Member A"), ("member-b", "Member B"), ("router-free", "Free router")]
+        .into_iter().map(|(slug, label)| {
+            let mut preset = template.clone();
+            preset.id = slug.to_string(); preset.model = slug.to_string();
+            preset.display_name = label.to_string(); preset.show_in_picker = true;
+            preset
+        }).collect();
+    chat.model_catalog = Arc::new(ModelCatalog::new(presets));
+    chat.config.model_provider_id = "lain".to_string();
+    chat.config.lain_model_picker = Some(LainModelPicker {
+        schema_version: 1,
+        groups: vec![LainModelGroup { id: "free".to_string(), name: "Free".to_string(),
+            router_model: router.then(|| "router-free".to_string()),
+            models: vec!["member-a".to_string()] }],
+    });
+}
+
+#[tokio::test]
+async fn lain_picker_opens_group_then_members_and_escape_returns_to_groups() {
+    let (mut chat, mut rx, _ops) = make_chatwidget_manual(Some("member-a")).await;
+    configure_lain_picker(&mut chat, false);
+    chat.open_model_popup_with_presets(chat.model_catalog.models.clone());
+    let root = render_bottom_popup(&chat, 80);
+    assert!(root.contains("Free") && root.contains("Alle"));
+    assert!(!root.contains("Member A"));
+    chat.handle_key_event(KeyCode::Enter.into());
+    let group_id = assert_matches!(rx.try_recv(), Ok(AppEvent::OpenLainModelGroupPopup { group_id }) => group_id);
+    assert_eq!(group_id, "free");
+    chat.open_lain_model_group_popup(&group_id);
+    let members = render_bottom_popup(&chat, 80);
+    assert!(members.contains("Automatisch") && members.contains("Noch nicht eingerichtet"));
+    assert!(members.contains("Member A") && !members.contains("Member B"));
+    chat.handle_key_event(KeyCode::Esc.into());
+    assert!(render_bottom_popup(&chat, 80).contains("Modellgruppe wählen"));
+    assert!(rx.try_recv().is_err());
+}
