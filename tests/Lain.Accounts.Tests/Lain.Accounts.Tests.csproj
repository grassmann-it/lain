<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><OutputType>Exe</OutputType></PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Lain.Core/Lain.Core.csproj" />
    <PackageReference Include="YamlDotNet" Version="16.3.0" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <Using Include="Microsoft.AspNetCore.Builder" /><Using Include="Microsoft.AspNetCore.Http" /><Using Include="Microsoft.AspNetCore.Routing" />
    <Compile Include="../../src/Lain.Host/Accounts/*.cs" Link="Accounts/%(Filename)%(Extension)" />
    <Compile Include="../../src/Lain.Host/Operations/*.cs" Link="Operations/%(Filename)%(Extension)" />
    <Compile Include="../../src/Lain.Host/Providers/*.cs" Link="Providers/%(Filename)%(Extension)" />
    <Compile Include="../../src/Lain.Host/Accounts/Monitoring/MonitorAccessCatalog.cs" Link="Accounts/MonitorAccessCatalog.cs" />
    <Compile Include="../../src/Lain.Host/Providers/NvidiaStep/*.cs" Link="Providers/NvidiaStep/%(Filename)%(Extension)" />
    <EmbeddedResource Include="../../src/Lain.Host/Providers/Catalog/*.json" LogicalName="Lain.Host.Providers.Catalog.%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
