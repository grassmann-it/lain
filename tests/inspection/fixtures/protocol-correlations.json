      "body": {
        "model": "fixture-claude-a",
        "max_tokens": 32,
        "messages": [
          {
            "role": "user",
            "content": "synthetic worker request"
          }
        ]
      },
      "expected": {
        "conversationId": "session-fixture",
        "workerId": "worker-fixture",
        "parentWorkerId": "parent-fixture",
        "turnId": null,
        "evidence": "harness_header"
