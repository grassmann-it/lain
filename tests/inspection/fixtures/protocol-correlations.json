      "protocol": "anthropic-messages",
      "headers": {
        "X-Claude-Code-Session-Id": "session-fixture",
        "X-Claude-Code-Agent-Id": "worker-fixture",
        "X-Claude-Code-Parent-Agent-Id": "parent-fixture"
